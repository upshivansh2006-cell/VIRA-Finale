# =====================================
# VIRA Environment Configuration
# =====================================

# Server Configuration
PORT=3000

# Rime Text-to-Speech (TTS) API Settings
RIME_API_KEY=YOUR_RIME_API_KEY
RIME_SPEAKER=eva
RIME_MODEL=mist

# Qdrant Vector Database Settings
# Local Docker: http://localhost:6333
# Qdrant Cloud: https://xyz-example.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Gemini AI (RAG response refinement)
# Get your key at: https://aistudio.google.com/app/apikey
# Optional — if missing, VIRA falls back to raw Qdrant protocol text
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
